{
  "name": "@funnel/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Funnel dashboard — browser subscriber UI (React + Vite), served from Cloudflare Workers static assets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@funnel/shared": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
