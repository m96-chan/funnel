# Funnel — local stack environment.
#
#   cp .env.example .env
#
# `.env` is gitignored at the repo root. Only the `server` service loads this
# file (docker-compose.yml `env_file`); coturn is configured from
# coturn/turnserver.conf, so a few values below exist in both places and have
# to be kept in sync by hand. Those are marked "mirrors turnserver.conf".

# ---------------------------------------------------------------------------
# Server — HTTP + WebSocket listener
#
# GET /healthz  liveness (also what the container HEALTHCHECK hits)
# WS  /ws       signaling
# ---------------------------------------------------------------------------

# Bind address inside the container. 0.0.0.0 so the published port reaches it;
# there is no reason to change this in Docker.
HOST=0.0.0.0

# Signaling port. docker-compose publishes host:container using this same
# value, so changing it here is enough.
PORT=8080

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Shared token every client presents in the `hello` handshake (publisher and
# subscriber alike). Leave it EMPTY and authentication is disabled — anyone who
# can reach the port can register a device, list devices and relay signaling.
# The server logs a loud warning in that case. Fine on a laptop, never exposed.
#
# Generate one with:  openssl rand -hex 32
FUNNEL_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# ICE servers
#
# The server hands these to both peers in `hello-ack` (see the IceServer type
# in shared/src/protocol.ts), so both sides always agree on STUN/TURN without
# any client-side configuration. All lists are comma-separated.
# ---------------------------------------------------------------------------

# STUN — address discovery. Google's public server is fine for development and
# is what the server falls back to if this is unset. Point it at your own
# coturn in production; a public STUN server is a third party watching you
# connect, and it can disappear.
STUN_URLS=stun:localhost:3478

# TURN — media relay, used when the peers cannot reach each other directly.
# Leave empty to disable TURN entirely (direct connections only; phones on
# mobile networks will often fail to connect).
#
# Use the host's LAN/public address, not localhost — the Android phone has to
# reach it too. `?transport=udp` is the relay path that actually matters;
# add a `turn:...?transport=tcp` entry as a fallback for UDP-blocking networks.
#
# mirrors turnserver.conf (listening-port)
TURN_URLS=turn:localhost:3478?transport=udp

# TURN credentials.
#
# !! CHANGE THESE BEFORE THE RELAY IS REACHABLE FROM ANYWHERE BUT LOCALHOST !!
# An open or default-credentialed TURN server is found and abused within hours.
# These must match the `user=` line in coturn/turnserver.conf exactly.
#
# The real answer for production is time-limited credentials minted per session
# from a shared secret (`use-auth-secret` / `static-auth-secret` in
# turnserver.conf) rather than a static user — see ../README.md.
#
# mirrors turnserver.conf (user=)
TURN_USERNAME=funnel
TURN_CREDENTIAL=change-me-turn-password

# ---------------------------------------------------------------------------
# coturn — not read by anything at runtime
#
# coturn runs with network_mode: host and reads only turnserver.conf, so the
# three values below are documentation: they record what the config file is set
# to, and what your firewall has to allow. Change turnserver.conf, then update
# these to match.
# ---------------------------------------------------------------------------

# Credential realm. Part of the long-term-credential hash, so changing it
# invalidates every issued TURN credential.
# mirrors turnserver.conf (realm=)
TURN_REALM=funnel.local

# Public address coturn advertises in relay candidates. Leave empty for
# localhost testing. If coturn sits behind NAT and this is wrong, ICE produces
# no `relay` candidate at all — the most common TURN failure by a wide margin.
# mirrors turnserver.conf (external-ip=)
TURN_EXTERNAL_IP=

# Relay UDP port range. Must be open end-to-end in the host firewall and any
# cloud security group.
# mirrors turnserver.conf (min-port= / max-port=)
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ---------------------------------------------------------------------------
# Redis — NOT YET USED
#
# The device registry is currently in-memory. Redis is in the compose stack so
# presence can move to it later (TTL expiry that survives a restart, shared
# across server instances). The server ignores this variable for now.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
