# Funnel server configuration. Copy to `.env` (git-ignored) and edit.

# --- HTTP / WebSocket listener ---------------------------------------------
# Interface to bind. 0.0.0.0 accepts connections from the local network.
HOST=0.0.0.0
# Port for both the WebSocket signaling endpoint and GET /healthz.
PORT=8080

# --- Auth -------------------------------------------------------------------
# Shared token every client must present in the `hello` handshake.
# Leave unset to disable authentication (development only — the server logs a
# loud warning at boot when it is missing).
# FUNNEL_AUTH_TOKEN=change-me

# --- ICE (handed to both peers in `hello-ack`) ------------------------------
# Comma-separated STUN URLs.
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated TURN URLs. Required for phones behind symmetric NAT / CGNAT.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# Long-term credentials for the TURN server above.
# TURN_USERNAME=funnel
# TURN_CREDENTIAL=change-me
